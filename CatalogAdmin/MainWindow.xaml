<Window x:Class="TiaCatalogAdmin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TIA Catalog Admin" Height="760" Width="1180" MinHeight="500" MinWidth="900">
    <DockPanel>
        <!-- Catalog source -->
        <Border DockPanel.Dock="Top" Padding="8" Background="#FFF3F3F3" BorderBrush="#FFDDDDDD" BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button Content="Open source…" Click="OpenSource_Click" />
                    <Button Content="New source…" Click="NewSource_Click" />
                    <Button x:Name="ImportTypesButton" Content="Import types from CSV…" Click="ImportTypes_Click" IsEnabled="False" />
                </StackPanel>
                <TextBlock x:Name="SourcePathText" VerticalAlignment="Center" Margin="8,0" Foreground="#FF555555"
                           Text="No catalog source open. Open or create catalog-source.db (keep it on the administrator PC)." />
            </DockPanel>
        </Border>

        <!-- Status -->
        <Border DockPanel.Dock="Bottom" Padding="8,4" Background="#FFF3F3F3" BorderBrush="#FFDDDDDD" BorderThickness="0,1,0,0">
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" />
        </Border>

        <TabControl x:Name="Tabs" Margin="6" IsEnabled="False">
            <!-- Kits -->
            <TabItem Header="Kits">
                <Grid Margin="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Column="0">
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Content="New kit from device…" Click="NewKit_Click" />
                            <Button Content="Delete kit" Click="DeleteKit_Click" />
                        </StackPanel>
                        <ListBox x:Name="KitList" SelectionChanged="KitList_SelectionChanged" DisplayMemberPath="Display" />
                    </DockPanel>

                    <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" />

                    <DockPanel Grid.Column="2" x:Name="KitPanel" IsEnabled="False">
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Content="Save kit" Click="SaveKit_Click" FontWeight="Bold" />
                            <Button Content="Discard changes" Click="DiscardKit_Click" />
                        </StackPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="4,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="Id" VerticalAlignment="Center" />
                                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="KitIdBox" IsReadOnly="True" Background="#FFF7F7F7" />
                                    <TextBlock Grid.Row="1" Text="Name" VerticalAlignment="Center" />
                                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="KitNameBox" />
                                    <TextBlock Grid.Row="2" Text="Description" VerticalAlignment="Center" />
                                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="KitDescriptionBox" />
                                    <TextBlock Grid.Row="3" Text="Device type" VerticalAlignment="Center" />
                                    <TextBox Grid.Row="3" Grid.Column="1" x:Name="KitTypeBox" IsReadOnly="True" Background="#FFF7F7F7" />
                                    <TextBlock Grid.Row="4" Text="Firmware" VerticalAlignment="Center" />
                                    <TextBox Grid.Row="4" Grid.Column="1" x:Name="KitFirmwareBox" />
                                    <TextBlock Grid.Row="5" Text="Device comment" VerticalAlignment="Center" />
                                    <TextBox Grid.Row="5" Grid.Column="1" x:Name="KitCommentBox" />
                                </Grid>

                                <TextBlock Text="Fixed part (derived from the example device, read-only)" FontWeight="Bold" Margin="0,12,0,4" />
                                <TextBox x:Name="FixedPartBox" IsReadOnly="True" FontFamily="Consolas" Background="#FFF7F7F7"
                                         TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" MaxHeight="180" VerticalScrollBarVisibility="Auto" />

                                <TextBlock x:Name="AllowedHeader" Text="Allowed modules (modular kit): optional limits per module" FontWeight="Bold" Margin="0,12,0,4" />
                                <DataGrid x:Name="AllowedGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="True"
                                          HeadersVisibility="Column" MaxHeight="220">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Module" Binding="{Binding Name}" IsReadOnly="True" Width="220" />
                                        <DataGridTextColumn Header="Catalog type" Binding="{Binding TypeKey}" IsReadOnly="True" Width="190" />
                                        <DataGridTextColumn Header="I/Q" Binding="{Binding Ranges, Mode=OneWay}" IsReadOnly="True" Width="110" />
                                        <DataGridTextColumn Header="Min slot" Binding="{Binding MinSlot, TargetNullValue=''}" Width="70" />
                                        <DataGridTextColumn Header="Max slot" Binding="{Binding MaxSlot, TargetNullValue=''}" Width="70" />
                                        <DataGridTextColumn Header="Max count" Binding="{Binding MaxCount, TargetNullValue=''}" Width="75" />
                                    </DataGrid.Columns>
                                </DataGrid>

                                <TextBlock Text="Tag templates ({DEVICE} = device name of each copy; offset in bits inside the range)" FontWeight="Bold" Margin="0,12,0,4" />
                                <DataGrid x:Name="TagsGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="True"
                                          HeadersVisibility="Column" MaxHeight="220">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Tag table" Binding="{Binding TagTable}" Width="160" />
                                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="170" />
                                        <DataGridTextColumn Header="Type" Binding="{Binding DataType}" Width="70" />
                                        <DataGridTextColumn Header="Module" Binding="{Binding ModuleName}" Width="110" IsReadOnly="True" />
                                        <DataGridTextColumn Header="I/Q" Binding="{Binding IoType}" Width="40" IsReadOnly="True" />
                                        <DataGridTextColumn Header="Bit offset" Binding="{Binding BitOffset}" Width="70" />
                                        <DataGridTextColumn Header="Comment" Binding="{Binding Comment}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- Types -->
            <TabItem Header="Types">
                <DataGrid x:Name="TypesGrid" Margin="6" IsReadOnly="True" AutoGenerateColumns="False" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Type key" Binding="{Binding TypeKey}" Width="200" />
                        <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="70" />
                        <DataGridTextColumn Header="Order number" Binding="{Binding Mlfb}" Width="170" />
                        <DataGridTextColumn Header="TIA" Binding="{Binding TiaVersion}" Width="50" />
                        <DataGridTextColumn Header="Type identifier" Binding="{Binding Identifier}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- Publish -->
            <TabItem Header="Publish">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Approved catalog folder" VerticalAlignment="Center" />
                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="ShareRootBox" />
                    <Button Grid.Row="0" Grid.Column="2" Content="…" Margin="6,2,0,2" Click="BrowseShare_Click" />

                    <TextBlock Grid.Row="1" Text="New version" VerticalAlignment="Center" />
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="VersionBox" />

                    <TextBlock Grid.Row="2" Text="Private key" VerticalAlignment="Center" />
                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="PrivateKeyBox" />
                    <Button Grid.Row="2" Grid.Column="2" Content="…" Margin="6,2,0,2" Click="BrowseKey_Click" />

                    <TextBlock Grid.Row="3" Text="Approved files (optional)" VerticalAlignment="Center" ToolTip="Folder with templates / block library copied into the package" />
                    <TextBox Grid.Row="3" Grid.Column="1" x:Name="ExtraFilesBox" />
                    <Button Grid.Row="3" Grid.Column="2" Content="…" Margin="6,2,0,2" Click="BrowseExtra_Click" />

                    <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,10">
                        <Button Content="Publish signed version" Click="Publish_Click" FontWeight="Bold" />
                        <Button Content="Verify current version" Click="Verify_Click" />
                    </StackPanel>

                    <TextBox Grid.Row="5" Grid.ColumnSpan="3" x:Name="PublishLog" IsReadOnly="True" FontFamily="Consolas"
                             VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" Background="#FFF7F7F7" />
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
