<Project Sdk="Microsoft.NET.Sdk">

  <!-- Shared, TIA-independent code: models, catalog, validation, CSV/Excel, SQLite.
       Used by TiaOpennessApp (net48) and the WPF editor / catalog admin apps. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>TiaOpennessApp</RootNamespace>
  </PropertyGroup>

  <!-- Trusted public key for approved catalog packages. Created by the administrator with
       the TiaOpennessApp catalog-keygen command; only the PUBLIC key file goes here. Without it,
       approved catalogs cannot be verified (and generation from project.db is refused). -->
  <ItemGroup>
    <EmbeddedResource Include="Security\catalog-public-key.json" Condition="Exists('Security\catalog-public-key.json')" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="CsvHelper" Version="33.1.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.0" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

</Project>
